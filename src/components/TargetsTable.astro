---
// A table on wide screens; each row becomes its own card on phones.
import { targets } from "../data/content";
---
<div class="table-wrap rv">
  <table>
    <thead><tr><th scope="col">Indicator</th><th scope="col">Target</th><th scope="col">SDG alignment</th><th scope="col">How we deliver</th></tr></thead>
    <tbody>
      {targets.map((t) => (
        <tr>
          <th scope="row">{t.indicator}</th>
          <td data-label="Target">{t.target}</td>
          <td data-label="SDGs"><div class="sdgs">{t.sdgs.map((s) => <span class="sdg">{s}</span>)}</div></td>
          <td data-label="How">{t.how}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .table-wrap { border: 1.5px solid var(--ink); border-radius: var(--radius); overflow: hidden; }
  table { border-collapse: collapse; width: 100%; font-size: 15.5px; }
  th, td { text-align: left; vertical-align: top; padding: 16px 18px; border-bottom: 1px solid var(--ash-soft); line-height: 1.5; }
  thead th { background: var(--ink); color: var(--yellow); font-family: var(--display); font-weight: 500; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; }
  tbody tr:last-child > * { border-bottom: 0; }
  tbody th { font-family: var(--display); font-weight: 600; font-size: 17px; }
  tbody tr { transition: background 0.2s ease; }
  tbody tr:hover { background: var(--cream); }
  .sdgs { display: flex; flex-wrap: wrap; gap: 6px; }
  .sdg { font-family: var(--display); font-weight: 600; font-size: 12.5px; background: var(--yellow); border-radius: 6px; padding: 2px 8px; white-space: nowrap; }

  @media (max-width: 720px) {
    .table-wrap { border: 0; border-radius: 0; overflow: visible; }
    table, tbody, tr, th, td { display: block; }
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    tbody { display: grid; gap: 12px; }
    tr { border: 1.5px solid var(--ink); border-radius: 16px; overflow: hidden; }
    tbody th { background: var(--ink); color: var(--paper); padding: 14px 16px; }
    td { display: grid; grid-template-columns: 76px 1fr; gap: 10px; padding: 10px 16px; font-size: 15px; }
    td::before { content: attr(data-label); font-family: var(--display); font-weight: 500; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ash); padding-top: 2px; }
    tbody tr > :last-child { border-bottom: 0; }
  }
</style>
