---
import { Image } from "astro:assets";
import Label from "./Label.astro";
import Button from "./Button.astro";
import { site } from "../data/site";
import { heroPhoto } from "../data/content";
---
<div class="hero bg-yellow">
  <div class="wrap grid">
    <div class="copy">
      <Label>{site.motto}</Label>
      <h1>Every youngster <span>is a young star.</span></h1>
      <p class="lede">YAY Foundation is a youth-led Nigerian foundation. We take menstrual hygiene, education, inclusion and environmental care into schools and communities, and we tie every outreach to the UN Sustainable Development Goals.</p>
      <div class="acts">
        <Button href="/partner" arrow>Partner with us</Button>
        <Button href="/#outreach" variant="ghost">See our outreach</Button>
      </div>
    </div>
    <div class="photo">
      <svg class="spin" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6l2.9 6 6.5.9-4.7 4.6 1.1 6.5L12 17.5l-5.8 3.1 1.1-6.5L2.6 9.5l6.5-.9z" fill="#141414" /></svg>
      <div class="frame">
        <Image src={heroPhoto.src} alt={heroPhoto.alt} widths={[420, 640, 900]} sizes="(max-width: 860px) 80vw, 480px" loading="eager" fetchpriority="high" />
      </div>
      <div class="badge"><strong>{site.tagline}</strong>Every child can become a star through education.</div>
    </div>
  </div>
</div>

<style>
  .hero { overflow: hidden; }
  .grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(28px, 5vw, 64px); align-items: center; padding-block: clamp(40px, 7vw, 84px); }
  h1 { font-size: clamp(42px, 5.6vw, 78px); font-weight: 800; margin: 22px 0; letter-spacing: -0.035em; }
  h1 span { font-weight: 300; display: block; }
  .lede { font-size: clamp(16.5px, 1.5vw, 20px); max-width: 33em; font-weight: 400; }
  .acts { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .photo { position: relative; }
  .frame { border-radius: 50%; overflow: hidden; aspect-ratio: 1; border: 10px solid var(--ink); background: var(--ink); }
  .frame :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 58% 40%; }
  .badge { position: absolute; left: -6px; bottom: 6%; background: var(--ink); color: var(--paper); font-family: var(--display); padding: 14px 18px; border-radius: 14px; max-width: 240px; font-size: 14.5px; line-height: 1.35; }
  .badge strong { color: var(--yellow); font-weight: 700; display: block; font-size: 17px; margin-bottom: 4px; letter-spacing: -0.01em; }
  .spin { position: absolute; right: 2%; top: 0; width: 92px; height: 92px; z-index: 1; animation: spin 22s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; padding-block: 28px 40px; gap: 26px; }
    .photo { order: -1; width: min(300px, 78vw); margin: 0 auto; }
    .spin { width: 64px; height: 64px; right: -4px; }
    .badge { left: 50%; transform: translateX(-50%); bottom: -14px; max-width: none; width: max-content; text-align: center; padding: 10px 16px; font-size: 13px; }
    .badge strong { font-size: 16px; margin-bottom: 0; }
    .badge { display: flex; flex-direction: column; }
    .copy { padding-top: 22px; }
    h1 { margin: 16px 0 14px; }
    .acts { margin-top: 22px; }
    .acts :global(.btn) { flex: 1 1 auto; justify-content: center; }
  }
</style>
