---
// The brand's black label bar ("ABOUT YAY", "OUR MISSION").
interface Props { tone?: "dark" | "yellow"; class?: string }
const { tone = "dark", class: cls } = Astro.props;
---
<span class:list={["label", tone, cls]}><slot /></span>

<style>
  .label {
    display: inline-block;
    font-family: var(--display); font-weight: 500; font-size: 14px; line-height: 1.3;
    letter-spacing: 0.14em; text-transform: uppercase;
    padding: 5px 64px 4px 10px;
  }
  .dark { background: var(--ink); color: var(--yellow); }
  .yellow { background: var(--yellow); color: var(--ink); }
  @media (max-width: 560px) { .label { padding-right: 28px; font-size: 13px; } }
</style>
