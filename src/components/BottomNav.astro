---
// Phone navigation: an app-style tab bar fixed to the bottom of the screen, within thumb reach.
// On the home page the tabs jump to sections, and the active tab follows your scroll position.
import Icon from "./Icon.astro";
import { nav } from "../data/site";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<nav class="tabbar" aria-label="Main">
  <ul>
    {nav.map((n) => {
      const active = (n.href === "/" && path === "/") || (n.href === "/partner" && path === "/partner");
      const spy = n.href === "/" ? "top" : n.href.startsWith("/#") ? n.href.slice(2) : undefined;
      return (
        <li>
          <a href={n.href} data-spy={spy} class:list={[active && "active", n.href === "/partner" && "cta"]} aria-current={active ? "page" : undefined}>
            <span class="ic"><Icon name={n.icon} size={21} /></span>
            <span class="tx">{n.short}</span>
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .tabbar { display: none; }
  @media (max-width: 860px) {
    .tabbar {
      display: block; position: fixed; z-index: 70; left: 0; right: 0; bottom: 0;
      background: var(--ink); color: var(--paper);
      border-top: 3px solid var(--yellow);
      padding: 6px 6px calc(6px + env(safe-area-inset-bottom));
    }
    ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 2px; }
    a {
      display: flex; flex-direction: column; align-items: center; gap: 3px;
      text-decoration: none; padding: 7px 2px 6px; border-radius: 14px;
      font-family: var(--display); font-weight: 500; font-size: 11.5px; letter-spacing: 0.01em;
      color: #bdbab0; transition: color 0.2s ease;
      -webkit-tap-highlight-color: transparent;
    }
    .ic { width: 44px; height: 28px; border-radius: 999px; display: grid; place-items: center; transition: background 0.25s var(--ease), color 0.2s ease, transform 0.15s ease; }
    a.active { color: var(--paper); }
    a.active .ic { background: var(--yellow); color: var(--ink); }
    a.cta:not(.active) { color: var(--yellow); }
    a:active .ic { transform: scale(0.92); }
  }
</style>

<script>
  // Scroll-spy for the home page: light up the tab (and desktop link) for the section in view.
  const ids = ["about", "work", "outreach"];
  const sections = ids.map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  if (sections.length) {
    const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>(".tabbar a[data-spy]"));
    const desk = Array.from(document.querySelectorAll<HTMLAnchorElement>(".desk-nav a[data-spy]"));
    const setActive = (id: string) => {
      tabs.forEach((a) => {
        const on = a.dataset.spy === id;
        a.classList.toggle("active", on);
        if (on) a.setAttribute("aria-current", "location"); else a.removeAttribute("aria-current");
      });
      desk.forEach((a) => a.classList.toggle("on", a.dataset.spy === id));
    };
    const update = () => {
      const line = window.innerHeight * 0.35;
      let current = "top";
      for (const s of sections) if (s.getBoundingClientRect().top <= line) current = s.id;
      const partnerBand = document.getElementById("partner-cta");
      if (partnerBand && partnerBand.getBoundingClientRect().top <= line) current = "partner-cta";
      setActive(current);
    };
    let ticking = false;
    window.addEventListener("scroll", () => {
      if (!ticking) { requestAnimationFrame(() => { update(); ticking = false; }); ticking = true; }
    }, { passive: true });
    update();
  }
</script>
