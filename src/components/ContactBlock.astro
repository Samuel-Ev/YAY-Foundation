---
// Contact details + message form.
// With a Web3Forms key in src/data/site.ts the form sends directly;
// without one it opens the visitor's email app with the message filled in.
import Label from "./Label.astro";
import Icon from "./Icon.astro";
import { site } from "../data/site";
---
<section class="section" id="contact">
  <div class="wrap grid">
    <div class="rv">
      <Label>Contact</Label>
      <h2>Send us a message.</h2>
      <p>Partnership ideas, invitations to visit a school, volunteering and press requests are all welcome.</p>
      <div class="reach">
        <a href={`mailto:${site.email}`}><span class="ic"><Icon name="mail" /></span><span><small>Email</small><b>{site.email}</b></span></a>
        <a href={site.instagram.url} rel="noopener" target="_blank"><span class="ic"><Icon name="instagram" /></span><span><small>Instagram</small><b>{site.instagram.handle}</b></span></a>
      </div>
    </div>

    <form id="contact-form" class="rv" novalidate data-key={site.web3formsKey} data-email={site.email}>
      <div class="field"><label for="f-name">Your name</label><input id="f-name" name="name" autocomplete="name" required /></div>
      <div class="field"><label for="f-email">Email address</label><input id="f-email" name="email" type="email" autocomplete="email" required /></div>
      <div class="field"><label for="f-org">Organisation (optional)</label><input id="f-org" name="organisation" autocomplete="organization" /></div>
      <div class="field"><label for="f-topic">I am writing about</label>
        <select id="f-topic" name="topic">
          <option>Partnership</option>
          <option>Giving or sponsorship</option>
          <option>Inviting YAY to a school</option>
          <option>Volunteering</option>
          <option>Press or general enquiry</option>
        </select>
      </div>
      <div class="field full"><label for="f-msg">Message</label><textarea id="f-msg" name="message" required></textarea></div>
      <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <div class="field full"><button class="btn" type="submit"><span class="btn-text">Send message</span><Icon name="arrow" size={18} /></button></div>
      <p class="full note">We use your details only to reply to you. See our <a href="/privacy">privacy policy</a>.</p>
      <p id="form-status" class="full" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(28px, 5vw, 70px); }
  h2 { font-size: clamp(32px, 4.8vw, 62px); font-weight: 700; margin: 18px 0 16px; }
  .reach { display: grid; gap: 12px; margin-top: 26px; }
  .reach a { display: grid; grid-template-columns: 48px 1fr; gap: 14px; align-items: center; text-decoration: none; border: 1.5px solid var(--ink); border-radius: 16px; padding: 12px 14px; transition: background 0.2s ease; }
  .reach a:hover { background: var(--yellow); }
  .ic { width: 48px; height: 48px; border-radius: 50%; background: var(--yellow); display: grid; place-items: center; }
  small { display: block; font-family: var(--display); font-weight: 500; font-size: 12.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ash); }
  .reach b { font-family: var(--display); font-weight: 600; font-size: 16.5px; word-break: break-word; }

  form { background: var(--cream); border-radius: 24px; padding: clamp(20px, 3vw, 36px); display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .field { display: grid; gap: 6px; }
  .full { grid-column: 1 / -1; }
  label { font-family: var(--display); font-weight: 500; font-size: 14.5px; }
  input, select, textarea { font: inherit; font-weight: 400; font-size: 16px; color: var(--ink); background: var(--paper); border: 1.5px solid var(--ink); border-radius: 12px; padding: 12px 14px; width: 100%; }
  textarea { min-height: 140px; resize: vertical; }
  input:focus, select:focus, textarea:focus { outline: 3px solid var(--yellow); outline-offset: 1px; }
  .hp { display: none; }
  #form-status { font-size: 15px; min-height: 1.4em; }
  .note { font-size: 13.5px; color: var(--ash); margin-top: -4px; }
  .note a { text-decoration-color: var(--yellow); text-decoration-thickness: 2px; }
  button[disabled] { opacity: 0.6; cursor: wait; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { form { grid-template-columns: 1fr; } form .btn { width: 100%; justify-content: center; } }
</style>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");
  if (form && status) {
    const key = form.dataset.key ?? "";
    const to = form.dataset.email ?? "";
    const label = form.querySelector(".btn-text");
    if (!key && label) label.textContent = "Prepare my email";

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const name = String(d.get("name") ?? "").trim();
      const email = String(d.get("email") ?? "").trim();
      const msg = String(d.get("message") ?? "").trim();
      if (!name || !email || !msg) { status.textContent = "Please add your name, your email address and a message."; return; }
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { status.textContent = "That email address does not look complete. Please check it."; return; }
      if (d.get("botcheck")) return;

      const subject = `${d.get("topic")} enquiry from ${name}`;

      if (!key) {
        const body = `Name: ${name}\nEmail: ${email}\nOrganisation: ${d.get("organisation") || "-"}\n\n${msg}`;
        window.location.href = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        status.textContent = `Your email app should now open with the message ready to send. If it did not, write to ${to}.`;
        return;
      }

      const btn = form.querySelector("button");
      btn?.setAttribute("disabled", "");
      status.textContent = "Sending your message…";
      try {
        d.append("access_key", key);
        d.append("subject", subject);
        d.append("from_name", "YAY Foundation website");
        const res = await fetch("https://api.web3forms.com/submit", { method: "POST", body: d });
        const json = await res.json();
        if (!json.success) throw new Error(json.message);
        form.reset();
        status.textContent = "Thank you. Your message has been sent and we will reply by email.";
      } catch {
        status.textContent = `Your message could not be sent. Please try again, or write to ${to}.`;
      } finally {
        btn?.removeAttribute("disabled");
      }
    });
  }
</script>
