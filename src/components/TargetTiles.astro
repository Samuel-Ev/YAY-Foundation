---
// The 2030 targets as big-number tiles. Same data as TargetsTable, presented as a quick
// "what your partnership helps deliver" summary for the contact page.
import { targets } from "../data/content";
---
<div class="tiles">
  {targets.map((t, i) => (
    <article class:list={["tile rv", i === 2 && "hero"]}>
      <span class="big">{t.big}</span>
      <p class="unit">{t.unit}</p>
      <div class="sdgs">{t.sdgs.map((s) => <span>{s}</span>)}</div>
    </article>
  ))}
</div>

<style>
  .tiles { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; }
  .tile { grid-column: span 2; background: var(--paper); border: 1.5px solid var(--ink); border-radius: var(--radius); padding: 22px 22px 20px; display: flex; flex-direction: column; gap: 8px; transition: transform 0.25s ease; }
  .tile:hover { transform: translateY(-4px); }
  .tile:nth-child(4), .tile:nth-child(5) { grid-column: span 3; }
  .hero { background: var(--ink); color: var(--paper); }
  .big { font-family: var(--display); font-weight: 800; font-size: clamp(34px, 4.2vw, 54px); line-height: 1; letter-spacing: -0.035em; font-variant-numeric: tabular-nums; }
  .hero .big { color: var(--yellow); }
  .unit { font-size: 15.5px; line-height: 1.45; max-width: 22em; }
  .hero .unit { color: var(--on-dark-muted); }
  .sdgs { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; padding-top: 8px; }
  .sdgs span { font-family: var(--display); font-weight: 600; font-size: 12px; background: var(--yellow); color: var(--ink); border-radius: 6px; padding: 2px 8px; }
  @media (max-width: 860px) {
    .tiles { grid-template-columns: 1fr 1fr; }
    .tile, .tile:nth-child(4), .tile:nth-child(5) { grid-column: span 1; }
    .hero { grid-column: 1 / -1 !important; order: -1; }
  }
  @media (max-width: 480px) { .tile { padding: 18px 16px; } .unit { font-size: 14.5px; } }
</style>
