---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/Button.astro";
---
<Layout title="Page not found">
  <PageHero label="Error 404" title="This page wandered off.">
    The link may be old or mistyped. The home page has everything else.
  </PageHero>
  <section class="section tight"><div class="wrap"><Button href="/" arrow>Back to the home page</Button></div></section>
</Layout>
